# La configuración con las credenciales nunca debe servirse por HTTP.
# Se prueban las dos sintaxis: si el módulo no está, la directiva daría un 500
# que dejaría toda la carpeta inservible.
<FilesMatch "^config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        <IfModule mod_access_compat.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </IfModule>
</FilesMatch>

# Algunos servidores no pasan la cabecera Authorization a PHP por CGI/FastCGI.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer"
</IfModule>
